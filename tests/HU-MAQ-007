import pytest
import requests
from datetime import datetime

BASE_URL = "http://localhost:8000/machinery"


def call_confirm_endpoint(machinery_id, token=None):
    url = f"{BASE_URL}/{machinery_id}/confirm-registration/"
    headers = {"Content-Type": "application/json"}
    if token:
        headers["Authorization"] = f"Bearer {token}"
    return requests.post(url, headers=headers, json={})


@pytest.mark.parametrize("machinery_id", [123])
def test_UT_MAQ_007_1_confirmacion_exitosa(machinery_id):
    """Confirmación exitosa de registro (HTTP 200)"""
    resp = call_confirm_endpoint(machinery_id)
    assert resp.status_code == 200
    data = resp.json()
    assert data["success"] is True
    assert data["data"]["machinery_id"] == machinery_id
    assert data["data"]["new_status"] == 4
    assert "modification_date" in data["data"]


@pytest.mark.parametrize("machinery_id", [999])
def test_UT_MAQ_007_2_maquinaria_no_encontrada(machinery_id):
    """Maquinaria no encontrada (HTTP 404)"""
    resp = call_confirm_endpoint(machinery_id)
    assert resp.status_code == 404
    data = resp.json()
