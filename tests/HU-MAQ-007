@pytest.mark.parametrize("machinery_id", [127])
def test_UT_MAQ_007_6_actualizacion_fecha(machinery_id):
    """Verificar que modification_date se actualiza"""
    resp = call_confirm_endpoint(machinery_id)
    assert resp.status_code == 200
    data = resp.json()
    assert data["success"] is True
    fecha_resp = data["data"]["modification_date"]
    hoy = datetime.today().strftime("%Y-%m-%d")
    assert fecha_resp.startswith(hoy)


