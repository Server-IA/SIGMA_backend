@pytest.mark.parametrize("machinery_id", [129])
def test_UT_MAQ_007_8_idempotencia(machinery_id):
    """Reintento posterior devuelve 400 por estado inválido"""
    resp = call_confirm_endpoint(machinery_id)
    assert resp.status_code == 400
    data = resp.json()
    assert data["success"] is False
    assert "no está en estado de registro" in data["message"]


@pytest.mark.parametrize("machinery_id", [130])
def test_UT_MAQ_007_9_disponibilidad_listado(machinery_id):
    """Disponibilidad en listado general tras confirmación"""
    resp = call_confirm_endpoint(machinery_id)
    assert resp.status_code == 200
    list_resp = requests.get(f"{BASE_URL}/?status=active")
    assert list_resp.status_code == 200
    ids = [item["id_machinery"] for item in list_resp.json()["data"]]
    assert machinery_id in ids


